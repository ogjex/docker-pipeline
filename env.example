# Copy to .env, fill in, and: chmod 600 .env   (never commit it)
# Values containing spaces or parentheses MUST be in quotes: this file is sourced by bash.
FORGEJO_URL=http://forgejo.lab.mrph.dk:3000
FORGEJO_API_TOKEN=        # token of the provisioning account (repo-provisioner)

ORG=myorg
REPO=new-project
TEMPLATE=myorg/repo-template      # owner/name of a repo marked as "Template"
DESCRIPTION=
PRIVATE=true
GITIGNORE_FILE=./python.gitignore # optional
OWNER_USER=                       # optional: user added as admin collaborator

# Secrets set on every new repo. Names must not start with gitea / forgejo / github.
DD_TOKEN=
DT_TOKEN=
SONAR_TOKEN=
CI_PR_TOKEN=                      # token of the comment bot (issue write only)
# Variables
DD_URL=http://defectdojo:8082
SONAR_URL=http://192.168.10.32:9000
DT_URL=http://192.168.10.32:8081

# DefectDojo asset creation (optional; skipped when DD_ADMIN_TOKEN is empty)
DD_ADMIN_TOKEN=                   # superuser token, used only by this script, NEVER stored in the repo
# DD_API_URL=http://192.168.10.32:8082   # if DD_URL is not resolvable from where you run the script
# DD_ORG=                         # defaults to ORG
# DD_ENGAGEMENT=forgejo-ci
DD_CI_USER=ci-bot                 # user to authorize on the new asset

# Branch protection (set PROTECT_BRANCH=false to skip)
PROTECT_BRANCH=true
REQUIRED_APPROVALS=0
# Comma-separated, exactly as shown in the PR's checks list
CHECKS="pr-security / secrets (pull_request),pr-security / sonar (pull_request),pr-security / sbom (pull_request),pr-security / iac (pull_request)"
# BRANCH=main        # default: the repo's default branch
